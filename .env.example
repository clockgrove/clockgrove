# Operator and tooling secret names of the hosted environments (development, staging, production).
# Names only: never write a value here. local and ci declare no secrets and need none of these.
# Supply each from the operator's secret manager session, never from a committed file.
# Worker secret bindings are in .dev.vars.example.
# Generated from requiredSecrets in infra/check-configuration.mjs and the secret table of
# docs/runbooks/infrastructure.md by scripts/check-env-examples.mjs (--write); pnpm check refuses drift.

# opentofu/cloudflare: OpenTofu Cloudflare provider.
CLOUDFLARE_API_TOKEN=

# opentofu/neon: OpenTofu Neon provider.
NEON_API_KEY=

# hyperdrive/runtime-role: Hyperdrive runtime-role connection.
DATABASE_URL=

# database/migrations: Controlled direct database migration connection.
MIGRATION_DATABASE_URL=

# database/support: Read-only support connection.
SUPPORT_DATABASE_URL=

# database/backup-verification: Backup verification connection.
BACKUP_DATABASE_URL=

# ai-gateway/provider: AI Gateway stored provider key.
MODEL_PROVIDER_API_KEY=

# runtime/turnstile: Public abuse verification consumer, once composed.
TURNSTILE_SECRET_KEY=

# operations/access: Operations Access service-token consumer.
CF_ACCESS_CLIENT_SECRET=

# observability/sentry: Observability exporter, once composed.
SENTRY_OTLP_TOKEN=
