{
  "name": "clockgrove",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "check": "biome check . && turbo run check --cache-dir=.turbo/cache && depcruise --config dependency-cruiser.config.mjs packages && node scripts/check-boundaries.mjs && node scripts/design-tokens.mjs && design.md lint DESIGN.md",
    "format": "biome check --write .",
    "db:migrate": "node scripts/database/migrate.mjs",
    "db:verify": "node scripts/database/verify.mjs",
    "test": "turbo run test --cache-dir=.turbo/cache",
    "test:long-run": "turbo run test:long-run --cache-dir=.turbo/cache",
    "test:db": "node scripts/database/test.mjs",
    "test:replay": "vitest run tests/replay",
    "test:runtime": "vitest run --config apps/runtime/vitest.runtime.config.ts",
    "test:runtime:interleaving": "vitest run --config apps/runtime/vitest.runtime.config.ts apps/runtime/test/world-owner.postgres.test.ts apps/runtime/test/world-owner/connection.postgres.test.ts",
    "test:runtime:alarms": "vitest run --config apps/runtime/vitest.runtime.config.ts apps/runtime/test/alarm-safety.test.ts apps/runtime/test/autonomous-cap.postgres.test.ts apps/runtime/test/autonomous-parity.postgres.test.ts apps/runtime/test/autonomous-recovery.postgres.test.ts apps/runtime/test/clock-admission.postgres.test.ts apps/runtime/test/clock-boundaries.postgres.test.ts apps/runtime/test/clock-schedule-boundaries.postgres.test.ts apps/runtime/test/timeline-clock.postgres.test.ts apps/runtime/test/due-work.postgres.test.ts",
    "test:runtime:queues": "vitest run --config apps/runtime/vitest.runtime.config.ts apps/runtime/test/queue-lifecycle.postgres.test.ts apps/runtime/test/dispatch-claims.postgres.test.ts apps/runtime/test/dispatch-delivery.postgres.test.ts apps/runtime/test/operator-inspector.postgres.test.ts",
    "test:runtime:workflows": "vitest run --config apps/runtime/vitest.runtime.config.ts apps/runtime/test/durable-provisioning.postgres.test.ts apps/runtime/test/durable-catch-up.postgres.test.ts apps/runtime/test/world-provisioning.postgres.test.ts apps/runtime/test/world-readiness.postgres.test.ts",
    "test:runtime:recovery": "vitest run --config apps/runtime/vitest.runtime.config.ts apps/runtime/test/native.postgres.test.ts apps/runtime/test/canonical-outage.postgres.test.ts apps/runtime/test/runtime.postgres.test.ts apps/runtime/test/hyperdrive.postgres.test.ts",
    "test:projection": "vitest run --root packages/contracts --config vitest.config.ts scene- asset-manifest",
    "test:realtime": "vitest run --config apps/runtime/vitest.runtime.config.ts apps/runtime/test/scene-admission.postgres.test.ts apps/runtime/test/scene-delivery.postgres.test.ts apps/runtime/test/observer-authority.postgres.test.ts apps/runtime/test/viewed-space.journey.postgres.test.ts apps/runtime/test/interaction-card.journey.postgres.test.ts",
    "test:web": "vitest run --config apps/web/vitest.config.ts convergence query-state",
    "test:scene": "vitest run --config apps/web/vitest.config.ts scene-adapter boundaries",
    "test:e2e": "vitest run --config tests/ci/vitest.browser.config.ts tests/e2e",
    "test:visual": "vitest run --config tests/ci/vitest.browser.config.ts tests/visual",
    "test:a11y": "vitest run --config tests/ci/vitest.browser.config.ts tests/accessibility",
    "test:realtime:load": "vitest run --config tests/ci/vitest.browser.config.ts tests/load/realtime",
    "verify:runtime-scenario-parity": "vitest run --config apps/runtime/vitest.long-run.config.ts apps/runtime/test/native-parity.long-run.test.ts apps/runtime/test/autonomous-parity.long-run.test.ts",
    "verify:docs": "python3 schemas/doc_validator.py adr docs/adr/*.md && python3 schemas/doc_validator.py wave docs/waves/*.md && python3 -m unittest schemas.test_doc_validator",
    "infra:validate": "node scripts/infra-validate.mjs",
    "infra:plan": "node scripts/infra-plan.mjs",
    "infra:owner": "node scripts/infra-owner.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "verify:supply-chain": "node scripts/supply-chain.mjs",
    "qualify:wave0": "node scripts/ci/qualify-wave0.mjs",
    "qualify:wave1": "node scripts/ci/qualify-wave1.mjs",
    "qualify:wave1:long-runs": "node scripts/ci/qualify-wave1-long-runs.mjs",
    "qualify:wave2": "node scripts/ci/qualify-wave2.mjs",
    "qualify:wave3": "node scripts/ci/qualify-wave3.mjs",
    "qualify:wave3:load-curves": "node scripts/ci/qualify-wave3-load-curves.mjs",
    "qualify:wave4": "node scripts/ci/qualify-wave4.mjs",
    "dev:world": "node scripts/dev-world.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@google/design.md": "0.4.0",
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.5.0",
    "playwright": "1.63.0",
    "turbo": "2.11.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  }
}
