    "/v1/runtime/talk": {
      "post": {
        "summary": "Private Caretaker Talk",
        "description": "Appends the participant's message and the actor's answer (the scripted model fixture) to an active session in one turn. Never spatial speech. An exact retry of a message ID returns its stored receipt; other text under it answers `409 message_id_reused`. `409 conversation_not_active`, `conversation_full` (1,000 messages) or `conversation_busy` (a concurrent message won).",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "tenantId",
                  "worldId",
                  "timelineId",
                  "spaceId",
                  "sessionId",
                  "messageId",
                  "text"
                ],
                "properties": {
                  "version": {
                    "const": 1
                  },
                  "tenantId": {
                    "type": "string"
                  },
                  "worldId": {
                    "type": "string"
                  },
                  "timelineId": {
                    "type": "string"
                  },
                  "spaceId": {
                    "type": "string"
                  },
                  "sessionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "messageId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "description": "Must not end with \":reply\": the answer to message x is stored as x:reply."
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "description": "At most 1024 UTF-8 octets, not blank."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TalkReceipt"
                }
              }
            }
          },
          "400": {
