{
  "openapi": "3.1.0",
  "info": {
    "title": "Clockgrove private conversations",
    "version": "1.0.0",
    "description": "Wave 5 RW-0501 local path. Every route needs `runtime:world-observe`; every route but `say` also needs the `conversation` privacy category and a resolved world persona. Contract: docs/protocols/conversations.md."
  },
  "paths": {
    "/v1/runtime/conversations/create": {
      "post": {
        "summary": "Open a private session with an actor",
        "description": "The actor must be an actor (an entity with needs) projected in the request's space: otherwise `409 talk_unavailable` or `409 selection_unavailable`. `409 conversation_limit_reached` past 100 sessions that are not deleted per participant and world timeline.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "tenantId",
                  "worldId",
                  "timelineId",
                  "spaceId",
                  "actorId"
                ],
                "properties": {
                  "version": {
                    "const": 1
                  },
                  "tenantId": {
                    "type": "string"
                  },
                  "worldId": {
                    "type": "string"
                  },
                  "timelineId": {
                    "type": "string"
                  },
                  "spaceId": {
                    "type": "string"
                  },
                  "actorId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "description": "No leading or trailing whitespace."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationSession"
                }
              }
            }
          },
          "400": {
            "description": "Refused: `{\"error\": code}`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Refused: `{\"error\": code}`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Refused: `{\"error\": code}`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Refused: `{\"error\": code}`.",
            "content": {
