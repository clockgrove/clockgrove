            "type": "array",
            "minItems": 1,
            "description": "The session's human participants (principal and world persona), ordered by principal ID; each principal and persona at most once. A Caretaker Talk session has exactly one.",
            "items": {
              "$ref": "#/components/schemas/ConversationSessionParticipant"
            }
          },
          "channel": {
            "const": "browser"
          },
          "privacyClass": {
            "const": "conversation"
          },
          "voiceMode": {
            "type": "string",
            "enum": [
              "cognitive",
              "interpreted",
              "canonical"
            ]
          },
          "disclosure": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "archived",
              "locked",
              "deleted"
            ]
          },
          "messageCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConversationMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "sequence",
          "messageId",
          "role",
          "authorId",
          "voiceMode",
          "text",
          "createdAt"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "messageId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "caretaker",
              "actor"
            ]
          },
          "authorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "voiceMode": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "cognitive",
                  "interpreted",
                  "canonical"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConversationTurn": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "turn",
          "inputSequence",
          "outputSequence",
          "model",
          "state",
          "createdAt"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "turn": {
            "type": "integer",
            "minimum": 1
          },
          "inputSequence": {
            "type": "integer"
          },
          "outputSequence": {
            "type": "integer"
          },
          "model": {
            "const": "scripted-fixture-v1"
          },
          "state": {
            "const": "completed"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConversationList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessions"
        ],
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversationSession"
            }
          }
        }
      },
      "ConversationTranscript": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session",
          "messages",
          "turns",
          "nextAfterSequence"
        ],
        "properties": {
          "session": {
            "$ref": "#/components/schemas/ConversationSession"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversationMessage"
            }
          },
          "turns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversationTurn"
            }
          },
          "nextAfterSequence": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "TalkReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "session",
          "message",
          "reply",
          "turn"
        ],
        "properties": {
          "type": {
            "const": "private_caretaker_talk"
          },
          "session": {
            "$ref": "#/components/schemas/ConversationSession"
          },
          "message": {
            "$ref": "#/components/schemas/ConversationMessage"
          },
          "reply": {
            "$ref": "#/components/schemas/ConversationMessage"
          },
          "turn": {
            "$ref": "#/components/schemas/ConversationTurn"
          }
        }
      },
      "SayReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "speech",
          "attribution"
        ],
        "properties": {
          "type": {
            "const": "public_say"
          },
          "speech": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "messageId",
              "scope",
              "speakerId",
              "text",
              "sentAt"
            ],
            "properties": {
              "type": {
                "const": "public_speech"
              },
              "messageId": {
                "type": "string"
              },
              "scope": {
                "$ref": "#/components/schemas/BrowserScope"
              },
              "speakerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "text": {
                "type": "string"
              },
              "sentAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "attribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principalId",
              "personaId"
            ],
            "properties": {
              "principalId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "personaId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "ConversationSessionParticipant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principalId",
          "personaId"
        ],
        "properties": {
          "principalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "personaId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
