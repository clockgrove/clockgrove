{
  "environment": "staging",
  "resources": {
    "worker": "rw-staging-runtime",
    "queues": {
      "worldReactions": {
        "name": "rw-staging-world-reactions",
        "deadLetter": "rw-staging-world-reactions-dlq"
      },
      "cognitiveIndexing": {
        "name": "rw-staging-cognitive-indexing",
        "deadLetter": "rw-staging-cognitive-indexing-dlq"
      },
      "externalEffects": {
        "name": "rw-staging-external-effects",
        "deadLetter": "rw-staging-external-effects-dlq"
      }
    },
    "buckets": {
      "artifacts": "rw-staging-artifacts",
      "assets": "rw-staging-assets",
      "backups": "rw-staging-backups"
    },
    "hyperdrive": "rw-staging-postgres",
    "analytics": "rw-staging-metrics",
    "aiGateway": "rw-staging-models",
    "serviceToken": "rw-staging-operations",
    "turnstile": "rw-staging-public",
    "database": {
      "project": "rw-staging-postgres",
      "branch": "rw-staging-main",
      "database": "rw-staging-world",
      "roles": {
        "migrations": "clockgrove_migrator",
        "runtime": "clockgrove_runtime",
        "support": "clockgrove_support",
        "backup": "clockgrove_backup",
        "authentication": "clockgrove_auth_verifier",
        "management": "clockgrove_management_reader",
        "worldAuthorization": "clockgrove_world_reader"
      },
      "region": "aws-us-west-2"
    }
  },
  "domains": {
    "runtime": "staging.runtime.example.org",
    "dnsTarget": "runtime.example.org"
  },
  "safeIds": {
    "cloudflareAccountId": "00000000000000000000000000000000",
    "cloudflareZoneId": "00000000000000000000000000000000"
  },
  "retention": {
    "queueSeconds": 86400,
    "databaseSeconds": 604800,
    "artifactDays": 30
  },
  "budgets": {
    "modelMonthlyUsd": 100,
    "requestsPerMinute": 60,
    "databaseMinCu": 0.25,
    "databaseMaxCu": 1
  },
  "compatibilityDate": "2026-10-01",
  "modelAliases": {
    "default": "interactive-standard",
    "background": "background-standard"
  },
  "authentication": {
    "origin": "https://staging.runtime.example.org",
    "providerEnvironment": "staging",
    "transport": "direct-postgresql"
  }
}
