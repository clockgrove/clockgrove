{
  "type": "object",
  "required": [
    "manifestVersion",
    "candidate",
    "execution",
    "versions",
    "commands",
    "tests",
    "fixtureHashes",
    "stateHashes",
    "migrations",
    "security",
    "recovery",
    "cloudQualification",
    "deployments",
    "focusedReview",
    "knownRisks",
    "waivers",
    "artifacts",
    "extensions",
    "browser",
    "wave0Checklist"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "candidate": {
      "type": "object",
      "required": [
        "commit",
        "tree",
        "buildDigest",
        "clean"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "buildDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "clean": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "provider",
        "runId",
        "runAttempt"
      ],
      "properties": {
        "provider": {
          "enum": [
            "github-actions",
            "local"
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runAttempt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": [
        "toolchain",
        "lockfileDigest",
        "contracts",
        "databaseMigrations",
        "infrastructureRevision",
        "runtime",
        "worldPacks",
        "policies"
      ],
      "properties": {
        "toolchain": {
          "type": "object",
          "required": [
            "node",
            "pnpm",
            "opentofu",
            "wrangler"
          ],
          "properties": {
            "node": {
              "type": "string",
              "minLength": 1
            },
            "pnpm": {
              "type": "string",
              "minLength": 1
            },
            "opentofu": {
              "type": "string",
              "minLength": 1
            },
            "wrangler": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "lockfileDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "contracts": {
          "type": "object",
          "required": [
            "version",
            "files"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "files": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "additionalProperties": false
        },
        "databaseMigrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "infrastructureRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runtime": {
          "type": "object",
          "required": [
            "compatibility_date",
            "compatibility_flags",
            "migrations"
          ]
        },
        "worldPacks": {
          "type": [
            "object",
            "null"
          ]
        },
        "policies": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "command",
          "status",
          "exitCode",
          "startedAt",
          "completedAt",
          "outputDigest"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unknown"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "startedAt": {
            "type": "string",
            "minLength": 1
          },
          "completedAt": {
            "type": "string",
            "minLength": 1
          },
          "outputDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signal": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^SIG[A-Z0-9]+$"
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "ENOENT",
              "EACCES",
              "ENOEXEC",
              "ENOBUFS",
              "ETIMEDOUT",
              "EINVAL",
              "EAGAIN",
              "EMFILE",
              "ENFILE",
              "ENOMEM",
              "E2BIG",
              "EIO",
              "ENOTDIR",
              "EPERM"
            ]
          },
          "tree": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "usage": {
            "type": "null",
            "description": "CPU and memory usage are explicitly unknown; elapsed timestamps remain actual."
          }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "command",
          "status",
          "exitCode",
          "startedAt",
          "completedAt",
