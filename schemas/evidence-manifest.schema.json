    "recovery": {
      "type": "object",
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "missing",
            "passed",
            "failed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "nativeRecovery": { "$ref": "#/properties/recovery" },
    "cloudQualification": {
      "type": "object",
      "required": [
        "status",
        "dependencies",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "environment",
          "commit",
          "buildDigest",
          "status",
          "phases"
        ],
        "properties": {
          "environment": {
            "enum": [
              "development",
              "staging",
              "production"
            ]
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "buildDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "held",
              "unknown"
            ]
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "commit",
                "command",
                "status",
                "exitCode",
                "startedAt",
                "completedAt",
                "outputDigest"
              ],
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "unknown"
                  ]
                },
                "exitCode": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "startedAt": {
                  "type": "string",
                  "minLength": 1
                },
                "completedAt": {
                  "type": "string",
                  "minLength": 1
                },
                "outputDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "signal": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^SIG[A-Z0-9]+$"
                },
                "errorCode": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    null,
                    "ENOENT",
                    "EACCES",
                    "ENOEXEC",
                    "ENOBUFS",
                    "ETIMEDOUT",
                    "EINVAL",
                    "EAGAIN",
                    "EMFILE",
                    "ENFILE",
                    "ENOMEM",
                    "E2BIG",
                    "EIO",
                    "ENOTDIR",
                    "EPERM"
                  ]
                },
                "tree": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "usage": {
                  "type": "null",
                  "description": "CPU and memory usage are explicitly unknown; elapsed timestamps remain actual."
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 2,
                  "description": "Which run of a retried deploy phase this is; absent on the first run."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "focusedReview": {
      "type": "object",
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
