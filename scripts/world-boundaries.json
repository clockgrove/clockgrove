{
  "enforceNames": true,
  "activation": "Platform identifiers are enforced; only the neutral fixture and playground worlds are allowed.",
  "identifiers": ["raccoon", "stevie", "juniper", "gracie", "grove."],
  "sourceRoots": ["apps", "packages", "scripts", "tools"],
  "allowPaths": [
    "worlds/fixture/",
    "worlds/playground/",
    "tests/",
    "scripts/world-boundaries.json"
  ],
  "allowSegments": ["test", "tests", "negative-boundaries"],
  "allowFilePattern": "\\.(?:test|spec)\\.",
  "worldRoot": "worlds",
  "platformWorlds": ["fixture", "playground"],
  "neutralWorlds": ["worlds/playground"]
}
